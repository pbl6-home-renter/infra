# Identity Service Configuration
APP_NAME=Rentify-Identity
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DB_SSL=true

# RabbitMQ Internal Connection
# User/password must match the "identity-service" line in env/rabbitmq-users.env.
RABBITMQ_URL=amqp://identity-service:change_me_identity@rabbitmq:5672
RABBITMQ_EXCHANGE=pbl6.events
RABBITMQ_EXCHANGE_TYPE=topic
# Keep false while other user.* events have no consumers; deploy Community email consumer first.
RABBITMQ_PUBLISH_MANDATORY=false

# JWT Authentication (RS256)
# Generate a key pair with openssl and store PEM values with literal \n escapes.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_KEY_ID=rentify-identity-2026-01
JWT_ISSUER=rentify-identity
JWT_AUDIENCE=rentify-api

# Shared secret for internal/* service-to-service endpoints (same value in every service)
SERVICE_TOKEN=change_me_shared_service_token

# Peer services on rentify-net (internal HTTP GET)
TENANCY_SERVICE_URL=http://tenancy:3002
COMMUNITY_SERVICE_URL=http://community:3004
INTERNAL_HTTP_TIMEOUT_MS=3000

# Public web app URL used to build password-reset links.
PUBLIC_APP_URL=https://your-web-app.example

# Reset links expire after 15 minutes; keep published email events only briefly.
OUTBOX_RETENTION_MS=900000
