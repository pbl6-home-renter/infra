# Identity Service Configuration
APP_NAME=Rentify-Identity
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DB_SSL=true

# RabbitMQ Internal Connection
RABBITMQ_DEFAULT_USER=rentify_admin
RABBITMQ_DEFAULT_PASS=rentify_secure_password_here
RABBITMQ_URL=amqp://rentify_admin:rentify_secure_password_here@rabbitmq:5672

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d
