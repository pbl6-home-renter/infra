# RabbitMQ user cho từng service. Mỗi dòng: <username>=<password>
#
# deploy.sh (qua scripts/sync-rabbitmq-users.sh) sẽ tự:
#   - tạo user nếu chưa có, hoặc đặt lại password theo file này,
#   - cấp quyền configure/write/read trên vhost "/".
#
# RABBITMQ_URL trong env/<service>.env phải dùng đúng user/password ở đây:
#   amqp://<username>:<password>@rabbitmq:5672
#
# Nên dùng password chỉ gồm chữ và số (ví dụ: openssl rand -hex 24)
# để không phải URL-encode khi đưa vào RABBITMQ_URL.
#
# Tài khoản admin (env/rabbitmq.env) không khai báo ở đây; script không đụng tới nó.

identity-service=change_me_identity
# tenancy-service=change_me_tenancy
# payment-service=change_me_payment
# community-service=change_me_community
