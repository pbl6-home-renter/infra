# Community Service runtime
APP_NAME=community-service
PORT=3004
NODE_ENV=production
LOG_LEVEL=info

# JWT verification and internal service authentication
JWKS_URL=http://identity:3001/api/v1/.well-known/jwks.json
JWT_ISSUER=rentify-identity
JWT_AUDIENCE=rentify-api
SERVICE_TOKEN=change_me_shared_service_token

# Peer services on the internal Docker network
IDENTITY_SERVICE_URL=http://identity:3001
TENANCY_SERVICE_URL=http://tenancy:3002
INTERNAL_HTTP_TIMEOUT_MS=3000

# Use a dedicated Community database. Replace placeholders on the server.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<database-host>:6543/postgres?pgbouncer=true
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<database-host>:5432/postgres
DB_SSL=true

# RabbitMQ runs on the edge host; replace host and credentials on the server.
RABBITMQ_URL=amqp://community-service:<password>@<EDGE_PRIVATE_HOST>:5672
RABBITMQ_EXCHANGE=pbl6.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_PREFETCH=10
RABBITMQ_CONNECT_TIMEOUT_MS=10000
RABBITMQ_PUBLISH_MANDATORY=true
RABBITMQ_CONSUMER_MAX_ATTEMPTS=5
RABBITMQ_CONSUMER_RETRY_DELAY_MS=10000

# Outbox runtime settings
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_PUBLISH_TIMEOUT_MS=5000
OUTBOX_CLAIM_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_RETENTION_MS=604800000

# Shared email transport; configure a valid SMTP provider before enabling email delivery.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=change_me
MAIL_PASS=change_me
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Rentify
EMAIL_DELIVERY_RETENTION_MS=7776000000
