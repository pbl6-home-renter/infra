# API Gateway Configuration
PORT=3000
NODE_ENV=production

# Upstream services (Docker internal network)
IDENTITY_SERVICE_URL=http://identity:3001
TENANCY_SERVICE_URL=http://tenancy:3002
PAYMENT_SERVICE_URL=http://payment:3003
COMMUNITY_SERVICE_URL=http://community:3004
PROXY_TIMEOUT_MS=10000

# JWT verification (must match env/identity.env)
JWKS_URL=http://identity:3001/api/v1/.well-known/jwks.json
JWT_ISSUER=rentify-identity
JWT_AUDIENCE=rentify-api

# Rate limiting (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
