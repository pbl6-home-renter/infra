(common) {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# API: http://<EC2_PUBLIC_IP>
:80 {
    import common
    reverse_proxy api-gateway:3000
}

# Web: http://<EC2_PUBLIC_IP>:5173
:5173 {
    import common
    reverse_proxy web:5173
}

:15672 {
    import common
    reverse_proxy rabbitmq:15672
}
