:80 {
    encode zstd gzip

    handle /identity-service/* {
        reverse_proxy identity:3001
    }
}

:5173 {
    encode zstd gzip

    reverse_proxy web:5173
}

:15672 {
    reverse_proxy rabbitmq:15672
}

